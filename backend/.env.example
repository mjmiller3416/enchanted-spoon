# backend/.env.example
#
# Copy to backend/.env and fill in values for local development.
# Never commit the real .env file.

# ── Environment ──────────────────────────────────────────────────────────
# "development" (default) or "production". In production, startup fails fast
# if auth is bypassed/unconfigured or the DB is still SQLite.
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────
# Defaults to a local SQLite file (app/database/app_data.db) if unset.
SQLALCHEMY_DATABASE_URL=sqlite:///./app_data.db

# ── Auth (Clerk) ─────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# AUTH_DISABLED=true bypasses JWT validation for local dev (uses DEV_USER_ID)
AUTH_DISABLED=true
DEV_USER_ID=1

# First-party integration auth (X-API-Key header on /api/shopping/external/*
# and the read-only /api/hearth/* meal routes for the Hearth wall display).
# Both resolve to INTEGRATION_USER_ID; Hearth's ENCHANTED_SPOON_DEVICE_TOKEN
# must equal INTEGRATION_API_KEY.
INTEGRATION_API_KEY=
INTEGRATION_USER_ID=

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Production target (deferred until public
# launch — see docs/plans/public-release-roadmap.md): https://enchantedspoon.app
CORS_ORIGINS=http://localhost:3000

# ── Stripe ───────────────────────────────────────────────────────────────
# Secret key from the Stripe dashboard (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# Signing secret for verifying webhook payloads (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price ID for the monthly Pro plan, $6.99/mo (price_...)
# Do not put a trial on the Price. Checkout adds the 7-day trial itself,
# and skips it when the account already used a trial.
STRIPE_PRICE_ID_PRO=
# Price ID for the annual Pro plan, $49.99/yr (price_...). Optional until
# the annual price exists; annual checkout returns 503 without it.
STRIPE_PRICE_ID_PRO_ANNUAL=

# ── Native in-app purchase (RevenueCat) ─────────────────────────────────
# Off until store products exist. The webhook is acknowledged and ignored
# while this is false, so point RevenueCat at it only after flipping it on.
NATIVE_IAP_ENABLED=false
# Exact Authorization header value configured in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Secret API key (sk_...) used to confirm a purchase from the server.
REVENUECAT_SECRET_API_KEY=
# Override only if the store product ids change.
# IAP_MONTHLY_PRODUCT_ID=com.enchantedspoon.app.pro.monthly
# IAP_ANNUAL_PRODUCT_ID=com.enchantedspoon.app.pro.annual
# Base URL of the frontend app, used to build Checkout success/cancel
# URLs and the billing-portal return URL.
# Production target (deferred until public launch): https://enchantedspoon.app
FRONTEND_URL=http://localhost:3000

# ── Gemini AI ────────────────────────────────────────────────────────────
GEMINI_ASSISTANT_API_KEY=
GEMINI_TIP_API_KEY=
GEMINI_IMAGE_API_KEY=
GEMINI_RECIPE_GENERATION_API_KEY=
GEMINI_NUTRITION_API_KEY=

# ── Cloudinary (image uploads) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── GitHub (issue tracking integration) ─────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=

# ── Sentry (error reporting; GlitchTip also works) ──────────────────────
# Leave blank to disable. Release and environment come from Railway.
SENTRY_DSN=
# Fraction of requests to trace for performance (0 = errors only)
SENTRY_TRACES_SAMPLE_RATE=0
