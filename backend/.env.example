# backend/.env.example
#
# Copy to backend/.env and fill in values for local development.
# Never commit the real .env file.

# ── Environment ──────────────────────────────────────────────────────────
# "development" (default) or "production". In production, startup fails fast
# if auth is bypassed/unconfigured or the DB is still SQLite.
ENVIRONMENT=development

# Instant of the coordinated release. Accounts created before this keep the
# free plan until Mar 31, 2027, 11:59 PM ET. ISO 8601. Naive values are Eastern.
# Required before a production deploy. If it is unset or not ISO 8601,
# production refuses to start and Railway keeps the previous deploy.
# Dev and test keep every account on the legacy free plan until it is set.
# PR #209 should read this same name.
# LEGACY_FREE_CUTOFF=2026-11-15T12:00:00-05:00
# Comma-separated user ids that keep the pre-release Pro allowances
# (150 photos, 500 chats, 300 suggestions, 100 imports) instead of the
# launch caps. An admin can set the same override per user in the admin
# panel (usage_exempt). Does not grant Pro. Admins stay uncapped.
# USAGE_EXEMPT_USER_IDS=1
# Comma-separated emails. Case-insensitive; surrounding spaces are trimmed.
# A match requires Clerk's verified primary email, cached for about 5 minutes.
# That account gets uncapped AI only. It does not open admin views or mutations.
# Set the real addresses on Railway before release. Do not commit them.
# ADMIN_EXEMPT_EMAILS=owner@example.com,partner@example.com

# ── Database ─────────────────────────────────────────────────────────────
# Defaults to a local SQLite file (app/database/app_data.db) if unset.
SQLALCHEMY_DATABASE_URL=sqlite:///./app_data.db

# ── Auth (Clerk) ─────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# AUTH_DISABLED=true bypasses JWT validation for local dev (uses DEV_USER_ID)
AUTH_DISABLED=true
DEV_USER_ID=1

# First-party integration auth (X-API-Key header on /api/shopping/external/*
# and the read-only /api/hearth/* meal routes for the Hearth wall display).
# Both resolve to INTEGRATION_USER_ID; Hearth's ENCHANTED_SPOON_DEVICE_TOKEN
# must equal INTEGRATION_API_KEY.
INTEGRATION_API_KEY=
INTEGRATION_USER_ID=

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Production target (deferred until public
# launch — see docs/plans/public-release-roadmap.md): https://enchantedspoon.app
CORS_ORIGINS=http://localhost:3000

# ── Stripe ───────────────────────────────────────────────────────────────
# Secret key from the Stripe dashboard (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# Signing secret for verifying webhook payloads (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price ID for the previous Pro price. Used only if STRIPE_PRICE_PRO_MONTHLY_V2 is unset.
STRIPE_PRICE_ID_PRO=
# Current tax-exclusive prices. Do not create these here; read the ids Railway already has.
STRIPE_PRICE_PRO_MONTHLY_V2=
STRIPE_PRICE_PRO_ANNUAL_V2=
# Promotion code ids (promo_...), not the typed FOUNDER30 / FOUNDER30Y strings.
# FOUNDER30 is monthly only. FOUNDER30Y is annual only. The annual id must be
# a code with no minimum amount: Stripe checks that minimum against the $0
# trial invoice. Checkout does not read restrictions.minimum_amount.
# STRIPE_PROMO_FOUNDER30_MONTHLY=
# STRIPE_PROMO_FOUNDER30_ANNUAL=
# When these are unset, FOUNDER30 and FOUNDER30Y stay live: checkout looks
# the typed code up in Stripe. Only FOUNDER_OFFER_ENDS_AT, or deactivating
# the codes in Stripe, turns that lookup off.
# Must be true before Checkout will start. Leave false until launch.
STRIPE_CHECKOUT_ENABLED=false
# Base URL of the frontend app, used to build Checkout success/cancel
# URLs and the billing-portal return URL.
# Production target (deferred until public launch): https://enchantedspoon.app
FRONTEND_URL=http://localhost:3000

# Access policy and checkout live in #210. This service does not read these
# for enforcement. Names match that PR. Naive timestamps are Eastern Time.
# LEGACY_FREE_CUTOFF is the coordinated release instant. Accounts created
# before it keep free until FREE_TIER_SUNSET_AT. Accounts created at or
# after it have no free AI allowance; the first AI action starts the trial.
# LEGACY_FREE_CUTOFF=
# FREE_TIER_SUNSET_AT=2027-03-31T23:59:00
# FOUNDER_OFFER_ENDS_AT=2027-03-31T23:59:00

# Push. Leave blank until the keys exist. Dispatch no-ops without them.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_AUTH_KEY=
# APNS_BUNDLE_ID=com.enchantedspoon.app
# APNS_USE_SANDBOX=true
# FCM_SERVER_KEY=
# PUSH_DISPATCH_SECRET=

# ── Native in-app purchase (RevenueCat) ─────────────────────────────────
# Off until store products exist. The webhook is acknowledged and ignored
# while this is false, so point RevenueCat at it only after flipping it on.
NATIVE_IAP_ENABLED=false
# Exact Authorization header value configured in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Secret API key (sk_...) used to confirm a purchase from the server.
REVENUECAT_SECRET_API_KEY=
# Override only if the store product ids change.
# IAP_MONTHLY_PRODUCT_ID=com.enchantedspoon.app.pro.monthly
# IAP_ANNUAL_PRODUCT_ID=com.enchantedspoon.app.pro.annual

# ── Gemini AI ────────────────────────────────────────────────────────────
GEMINI_ASSISTANT_API_KEY=
GEMINI_TIP_API_KEY=
GEMINI_IMAGE_API_KEY=
GEMINI_RECIPE_GENERATION_API_KEY=
GEMINI_NUTRITION_API_KEY=

# Post-launch option, leave blank. Instagram import uses the public page's
# Open Graph description by default (no Meta app). If this token is set later,
# Instagram uses Meta's free oEmbed Read API instead. Not a paid service.
# TikTok import uses TikTok's public oEmbed and needs no key. There is no
# transcript API; the import screen can paste a caption when a post can't be read.
INSTAGRAM_OEMBED_ACCESS_TOKEN=

# ── Cloudinary (image uploads) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── GitHub (issue tracking integration) ─────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=

# ── Sentry (error reporting; GlitchTip also works) ──────────────────────
# Leave blank to disable. Release and environment come from Railway.
SENTRY_DSN=
# Fraction of requests to trace for performance (0 = errors only)
SENTRY_TRACES_SAMPLE_RATE=0
