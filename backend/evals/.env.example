# ── Whiskful AI eval harness — provider keys ────────────────────────────────
# The eval calls each provider directly (it does NOT touch app code). promptfoo
# reads the STANDARD env var names below. The dedicated $5-capped eval keys live
# in backend/.env under different names, so map them before running:
#
#   export GOOGLE_API_KEY=$(grep '^GEMINI_EVAL_API_KEY='   ../.env | cut -d= -f2- | tr -d '\r')
#   export OPENAI_API_KEY=$(grep '^OPENAI_EVAL_API_KEY='   ../.env | cut -d= -f2- | tr -d '\r')
#   export ANTHROPIC_API_KEY=$(grep '^ANTHROPIC_EVAL_API_KEY=' ../.env | cut -d= -f2- | tr -d '\r')
#
# Or copy this file to backend/evals/.env and paste the key values directly.
#
# NOTE ON KEY ATTRIBUTION: production uses a separate Gemini key PER SERVICE for
# billing attribution + quota isolation (landmine #3 in the plan). The OFFLINE
# eval deliberately collapses to one key per provider — it measures the model, not
# per-feature billing. Preserving per-(provider,service) keys is a Phase 1 concern.

# Google Gemini (AI Studio). promptfoo auto-detects GOOGLE_API_KEY (or GEMINI_API_KEY).
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude) — used both as a candidate provider AND (by default) as the
# LLM judge. See README "The judge & self-preference bias".
ANTHROPIC_API_KEY=
