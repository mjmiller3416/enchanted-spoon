# Bundle id for the Capacitor iOS app. The share extension
# (com.enchantedspoon.app.share) is signed with the same team inside the
# archive; it is not a separate App Store Connect app.
app_identifier("com.enchantedspoon.app")

# Mitchell's individual team (EnchantedSpoon::DEFAULT_APPLE_TEAM_ID).
# APPLE_TEAM_ID overrides it when the GitHub Actions secret is set.
# Team IDs are not secrets. Do not put a .p8 or a certificate here.
require_relative "signing_project"
apple_team = ENV["APPLE_TEAM_ID"].to_s.strip
apple_team = EnchantedSpoon::DEFAULT_APPLE_TEAM_ID if apple_team.empty?
team_id(apple_team)
