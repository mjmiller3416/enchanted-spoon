# Bundle id for the Capacitor iOS app. The share extension
# (com.enchantedspoon.app.share) is signed with the same team inside the
# archive; it is not a separate App Store Connect app.
app_identifier("com.enchantedspoon.app")

# Developer Team ID from the APPLE_TEAM_ID GitHub Actions secret.
# Do not hard-code it. An empty value is normal when listing lanes locally.
apple_team = ENV["APPLE_TEAM_ID"].to_s.strip
team_id(apple_team) unless apple_team.empty?
