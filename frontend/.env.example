# Copy to frontend/.env.local. NEXT_PUBLIC_* values are baked into the
# hosted web bundle, which is what the Capacitor shell loads.

NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Native in-app purchase. Leave false until App Store Connect, Play Console,
# and RevenueCat are configured. The shell still hides Stripe Checkout.
NEXT_PUBLIC_NATIVE_IAP_ENABLED=false
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# NEXT_PUBLIC_IAP_MONTHLY_PRODUCT_ID=com.enchantedspoon.app.pro.monthly
# NEXT_PUBLIC_IAP_ANNUAL_PRODUCT_ID=com.enchantedspoon.app.pro.annual

# Baked into the native project by `npx cap sync`, not into the web bundle.
# CAPACITOR_SERVER_URL=http://localhost:3000

# Same instant as backend FREE_PLAN_SUNSET_AT / FREE_PLAN_SUNSET_TIMEZONE.
# Grandfathered free access and FOUNDER30 both end here.
# NEXT_PUBLIC_FREE_PLAN_SUNSET_AT=2027-03-31T23:59:00
# NEXT_PUBLIC_FREE_PLAN_SUNSET_TIMEZONE=America/New_York
