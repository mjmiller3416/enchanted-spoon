# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

cat >> frontend/.gitignore << EOF
# dependencies
/node_modules
/.vscode
/.claude
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor — generated on cap sync / local builds
ios/App/Pods
ios/App/App/public
ios/DerivedData
ios/App/App.xcworkspace/xcuserdata
android/.gradle
android/build
android/app/build
android/local.properties
android/app/src/main/assets/public
android/capacitor-cordova-android-plugins
*.xcuserstate
